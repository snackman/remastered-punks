{
  "buildCommand": "cd preview/remaster && npm install && npm run build && node ../../scripts/build-public-data.mjs dist/data",
  "outputDirectory": "preview/remaster/dist",
  "installCommand": "cd api && npm install && cd .. && cd preview/remaster && npm install",
  "framework": null,
  "functions": {
    "api/[punkId].js": {
      "includeFiles": "data/{cryptopunks-assets/punks/config/punks-24x24.png,punks-attributes/original/cryptopunks.csv,all-eligible-punks.json}"
    },
    "api/metadata/[id].js": {
      "includeFiles": "data/{punks-attributes/original/cryptopunks.csv,all-eligible-punks.json,remaster-pixel-counts.json}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800" }]
    },
    {
      "source": "/([^/]+\\.(?:png|svg|webp))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/metadata/contract.json",
      "destination": "/api/metadata/contract"
    },
    {
      "source": "/api/metadata/:id(\\d+).json",
      "destination": "/api/metadata/:id"
    },
    {
      "source": "/:punkId(\\d+)",
      "destination": "/api/:punkId"
    }
  ]
}
