# All VITE_* values are inlined into the client bundle and are PUBLIC.
# RPC keys must be origin-restricted (punksremastered.com, *.vercel.app, localhost).

# Which network the build targets: sepolia (default if unset) or mainnet.
# On Vercel Production this MUST be set explicitly (the build fails otherwise).
VITE_NETWORK=sepolia

# Mainnet mode only (required): checksummed RemasteredPunks address. Ignored in sepolia mode.
# VITE_REMASTERED_PUNKS_MAINNET=0x...

# Mainnet mode: required, must start with https://. Sepolia mode: optional (public RPC fallback).
# VITE_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<origin-restricted-key>

# Sepolia mode only, optional (falls back to the public RPC).
# VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<origin-restricted-key>

# Optional; defaults to the project's current WalletConnect/Reown ID.
# VITE_WALLETCONNECT_PROJECT_ID=

# Get a free API key at https://alchemy.com
# (kept until owned-punks-multicall removes it from ownedPunks.js)
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here
